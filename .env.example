# ============================================================
# Tech Challenge Fase 2 — variáveis de ambiente
# Copie para .env e ajuste conforme o seu ambiente:
#   cp .env.example .env
# O arquivo .env NUNCA deve ser commitado (veja .gitignore).
# ============================================================

# ── MLflow ───────────────────────────────────────────────────
# Backend SQLite é obrigatório: o Model Registry não funciona
# com o store baseado em arquivos (./mlruns).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=purchase-intent
MLFLOW_REGISTERED_MODEL=purchase-intent-classifier
MLFLOW_MODEL_ALIAS=champion

# ── Dados ────────────────────────────────────────────────────
DATA_URL=https://archive.ics.uci.edu/static/public/468/online+shoppers+purchasing+intention+dataset.zip
RAW_DATA_PATH=data/raw/online_shoppers_intention.csv
PROCESSED_DIR=data/processed

# ── Artefatos ────────────────────────────────────────────────
MODEL_DIR=models
REPORTS_DIR=reports

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Porta do HOST no docker-compose (a interna continua sendo 8000).
# No EC2 use 80 para responder na porta padrão de HTTP.
HOST_PORT=8000

# ── Rede ─────────────────────────────────────────────────────
# Só é necessário atrás de proxy corporativo ou antivírus que faz
# inspeção TLS (o download do dataset falha com CERTIFICATE_VERIFY_FAILED).
# Aponte para um bundle PEM que inclua a CA raiz da sua rede.
# CA_BUNDLE=C:/caminho/para/ca-bundle.pem

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
