# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
wheels/

# ── Ambientes virtuais ───────────────────────────────────────
.venv/
venv/
env/

# ── Dados e artefatos pesados (versionados pelo DVC, não pelo git) ──
/data/raw/
/data/processed/
/models/*.joblib

# reports/ NÃO entra aqui: métricas, curvas e a tabela de comparação são
# saídas `cache: false` do DVC e vivem no git, para que `dvc metrics diff`
# compare execuções entre commits. O DVC gera reports/.gitignore para as
# saídas que realmente pertencem ao cache.

# ── DVC ──────────────────────────────────────────────────────
/.dvc/cache/
/.dvc/tmp/
/.dvc/config.local
/dvc-storage/

# ── MLflow ───────────────────────────────────────────────────
mlruns/
mlartifacts/
mlflow.db

# ── Testes e cobertura ───────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Segredos e configuração local ────────────────────────────
.env
.env.*
!.env.example

# ── Sistema operacional ──────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Certificados locais de inspeção TLS (específicos por máquina) ───
certs/*.crt
certs/*.pem

# ── Material de apoio interno (nao vai para o repositorio) ─────────
